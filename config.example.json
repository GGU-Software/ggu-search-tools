{
  "firecrawl": {
    "apiKey": "fc-your-api-key-here"
  },
  "pinecone": {
    "apiKey": "pcsk_your-api-key-here",
    "assistantName": "ggu-product-docs",
    "host": "https://prod-eu-data.ke.pinecone.io"
  },
  "sources": [
    {
      "name": "product-website",
      "url": "https://www.ggu-software.com",
      "excludePaths": [
        "/en/*"
      ],
      "limit": 500
    },
    {
      "name": "user-manuals",
      "url": "https://manuals.ggu-software.com/ger/",
      "limit": 6000
    }
  ],
  "output": {
    "directory": "./output"
  }
}
